# InsightAI Environment Configuration

# Server Port (fixed to 3000 by infrastructure in AI Studio)
PORT=3000

# LLM API Key: Server-side secret for Gemini API
# Injected runtime secret from AI Studio Secrets panel. Never expose to client.
GEMINI_API_KEY=""

# Cloud Run host URL
APP_URL=""

# Database Configuration (Future persistence layer)
# Option A: Cloud SQL / PostgreSQL Connection URI
DATABASE_URL=""

# Option B: Individual Database connection parameters
DB_HOST=""
DB_PORT="5432"
DB_NAME="insightai"
DB_USER=""
DB_PASSWORD=""
DB_SSL="true"

# Data Ingestion & RAG Settings
MAX_BATCH_INGEST_SIZE="500"
EMBEDDING_BATCH_SIZE="100"
